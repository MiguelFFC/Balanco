# Copie este arquivo para ".env" e preencha com os dados do SEU projeto Supabase.
# Onde encontrar: painel do Supabase > botão "Connect" (topo) ou
# Project Settings > Data API (URL) e Project Settings > API Keys (chave).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_KEY=cole-aqui-a-chave-publishable-ou-anon
